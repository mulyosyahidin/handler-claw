{
  "openapi": "3.0.0",
  "info": {
    "title": "HandlerClaw API",
    "description": "API Documentation for HandlerClaw Project",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Root Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshToken": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "PrayerLog": {
        "type": "object",
        "properties": {
          "prayer": {
            "type": "string",
            "enum": [
              "SUBUH",
              "DZUHUR",
              "ASHAR",
              "MAGHRIB",
              "ISYA",
              "JUMAT",
              "DHUHA",
              "TAHAJUD",
              "WITIR"
            ]
          },
          "local_date": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "performed_at": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "method": {
            "type": "string",
            "enum": [
              "JAMAAH",
              "SENDIRI"
            ]
          },
          "place": {
            "type": "string",
            "enum": [
              "MASJID",
              "RUMAH",
              "LAINNYA"
            ]
          },
          "is_qadha": {
            "type": "boolean",
            "nullable": true,
            "default": false
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "prayer"
        ]
      },
      "CreateWhatsappLog": {
        "type": "object",
        "properties": {
          "quick": {
            "type": "boolean",
            "default": false,
            "description": "Is quick reply"
          },
          "device": {
            "type": "string",
            "maxLength": 30,
            "example": "6282281666584"
          },
          "mode": {
            "type": "string",
            "maxLength": 10,
            "example": "lid"
          },
          "sender": {
            "type": "string",
            "maxLength": 50,
            "example": "6281178714117"
          },
          "senderlid": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              }
            ],
            "example": "24104027574456@lid"
          },
          "pengirim": {
            "type": "string",
            "maxLength": 50,
            "description": "Alias for sender"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              }
            ],
            "example": "Martin Mulyo Syahidin"
          },
          "isgroup": {
            "type": "boolean",
            "default": false
          },
          "member": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              }
            ]
          },
          "memberlid": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              }
            ]
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              }
            ],
            "example": "Halo gaes"
          },
          "pesan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              }
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 100,
            "example": "non-button message"
          },
          "type": {
            "type": "string",
            "maxLength": 20,
            "example": "text"
          },
          "isforwarded": {
            "type": "boolean",
            "default": false
          },
          "inboxid": {
            "type": "integer",
            "default": 0
          },
          "extension": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              }
            ]
          },
          "filename": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              }
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              }
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 500,
            "format": "uri",
            "description": "Media or external URL"
          },
          "pollname": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              }
            ]
          },
          "choices": {
            "type": "array",
            "items": {
              "nullable": true
            },
            "default": []
          },
          "timestamp": {
            "type": "string",
            "pattern": "^d+$",
            "example": 1773466456,
            "description": "Original WA epoch timestamp"
          }
        },
        "required": [
          "device",
          "mode",
          "sender",
          "type",
          "timestamp"
        ]
      },
      "CreateReminderHook": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "meta": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          },
          "link_to": {
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "type",
          "title",
          "message"
        ]
      },
      "CreateUserDevice": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1
          },
          "device_brand": {
            "type": "string"
          },
          "device_model": {
            "type": "string"
          },
          "os_version": {
            "type": "string"
          },
          "fcm_token": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "enum": [
              "ANDROID",
              "IOS",
              "WEB",
              "WINDOWS"
            ],
            "default": "ANDROID"
          }
        },
        "required": [
          "device_id",
          "fcm_token"
        ]
      },
      "UpdateUserDeviceStatus": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "LOGGED_OUT",
              "INVALID_TOKEN"
            ]
          }
        },
        "required": [
          "device_id",
          "status"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "User Login",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/auth/refresh-access-token": {
      "post": {
        "summary": "Refresh Access Token",
        "description": "Renew access token using the old token",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshToken"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token successfully refreshed"
          },
          "401": {
            "description": "Unauthorized / Invalid Token"
          }
        }
      }
    },
    "/api/prayer-logs": {
      "get": {
        "summary": "Get Prayer Logs",
        "description": "Mengambil daftar jurnal solat.",
        "tags": [
          "Prayer Logs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "this_week",
                "this_month",
                "this_year",
                "7_days",
                "30_days",
                "1_year",
                "all",
                "custom"
              ],
              "default": "all"
            },
            "required": false,
            "name": "date_type",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "required": false,
            "name": "start",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "required": false,
            "name": "end",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Create a new Prayer Log",
        "description": "Menyimpan atau memperbarui data jurnal solat.",
        "tags": [
          "Prayer Logs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrayerLog"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prayer log berhasil disimpan/diupdate"
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "Conflict"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/prayer-logs/summary": {
      "get": {
        "summary": "Get Prayer Logs Summary",
        "description": "Mengambil ringkasan statistik jurnal solat.",
        "tags": [
          "Prayer Logs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "this_week",
                "this_month",
                "this_year",
                "7_days",
                "30_days",
                "1_year",
                "all",
                "custom"
              ],
              "default": "all"
            },
            "required": false,
            "name": "date_type",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "required": false,
            "name": "start",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "required": false,
            "name": "end",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get Current User Profile",
        "description": "Mengambil data profil pengguna yang sedang login.",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil mengambil data profil"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "User tidak ditemukan"
          }
        }
      }
    },
    "/api/whatsapp-logs": {
      "post": {
        "summary": "Create a new WhatsApp log",
        "description": "Menyimpan satu entri log WhatsApp yang diterima dari webhook.",
        "tags": [
          "WhatsApp Logs"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWhatsappLog"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Log berhasil disimpan"
          },
          "422": {
            "description": "Validation error"
          }
        }
      },
      "get": {
        "summary": "Get WhatsApp logs (cursor-based pagination)",
        "description": "Mengambil daftar WhatsApp log dengan cursor-based pagination. Gunakan `next_cursor` dari response sebagai nilai `cursor` pada request berikutnya.",
        "tags": [
          "WhatsApp Logs"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true,
              "description": "ID of the last item from the previous page",
              "example": 100
            },
            "required": false,
            "description": "ID of the last item from the previous page",
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Number of items to return (max 200)",
              "example": 50
            },
            "required": false,
            "description": "Number of items to return (max 200)",
            "name": "take",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "this_week",
                "this_month",
                "this_year",
                "7_days",
                "30_days",
                "1_year",
                "all",
                "custom"
              ],
              "default": "all"
            },
            "required": false,
            "name": "date_type",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "required": false,
            "name": "start",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "required": false,
            "name": "end",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/whatsapp-logs/summary": {
      "get": {
        "summary": "Get WhatsApp logs summary",
        "description": "Mengambil ringkasan statistik WhatsApp log (jumlah, berdasarkan device, tipe pesan, dll) serta daftar pesan yang dikelompokkan per hari dan per pengirim (di dalam field `messages`).",
        "tags": [
          "WhatsApp Logs"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "this_week",
                "this_month",
                "this_year",
                "7_days",
                "30_days",
                "1_year",
                "all",
                "custom"
              ],
              "default": "all"
            },
            "required": false,
            "name": "date_type",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "required": false,
            "name": "start",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "required": false,
            "name": "end",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/reminder-hooks": {
      "post": {
        "summary": "Create a new Reminder Hook",
        "description": "Menyimpan webhook reminder baru (membutuhkan autentikasi). Jika event_id sudah ada, data akan di-update (upsert).",
        "tags": [
          "Reminder Hooks"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReminderHook"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reminder hook berhasil disimpan"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation error"
          }
        }
      },
      "get": {
        "summary": "Get Reminder Hooks (offset pagination)",
        "description": "Mengambil daftar reminder hook milik pengguna saat ini.",
        "tags": [
          "Reminder Hooks"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true,
              "default": 1,
              "description": "Nomor halaman (1-based), default: 1",
              "example": 1
            },
            "required": false,
            "description": "Nomor halaman (1-based), default: 1",
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 10,
              "description": "Jumlah data per halaman (max 200), default: 10",
              "example": 10
            },
            "required": false,
            "description": "Jumlah data per halaman (max 200), default: 10",
            "name": "per_page",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/reminder-hooks/summary": {
      "get": {
        "summary": "Get Reminder Hooks Summary",
        "description": "Mengambil ringkasan statistik (jumlah berdasarkan status) dari reminder hooks milik pengguna saat ini.",
        "tags": [
          "Reminder Hooks"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil mengambil summary"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/user-devices": {
      "post": {
        "summary": "Register / Update a User Device",
        "description": "Mendaftarkan perangkat pengguna untuk push notification. Jika device_id sudah ada, data akan di-update (upsert).",
        "tags": [
          "User Devices"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserDevice"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Perangkat berhasil didaftarkan"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation error"
          }
        }
      },
      "get": {
        "summary": "Get User Devices (offset pagination)",
        "description": "Mengambil daftar perangkat milik pengguna saat ini.",
        "tags": [
          "User Devices"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true,
              "default": 1,
              "description": "Nomor halaman (1-based), default: 1",
              "example": 1
            },
            "required": false,
            "description": "Nomor halaman (1-based), default: 1",
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 10,
              "description": "Jumlah data per halaman (max 200), default: 10",
              "example": 10
            },
            "required": false,
            "description": "Jumlah data per halaman (max 200), default: 10",
            "name": "per_page",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/user-devices/status": {
      "patch": {
        "summary": "Update User Device Status",
        "description": "Memperbarui status perangkat (misal: LOGGED_OUT, ACTIVE).",
        "tags": [
          "User Devices"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserDeviceStatus"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status berhasil diperbarui"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    }
  }
}