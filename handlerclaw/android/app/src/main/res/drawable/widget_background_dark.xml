<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Base Dark Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1a1a2e"
                android:centerColor="#16213e"
                android:endColor="#0f3460" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Layer 2: Subtle Top-left Glow (Purple) -->
    <item
        android:top="-30dp"
        android:left="-20dp"
        android:width="120dp"
        android:height="120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60dp"
                android:startColor="#4D764BA2"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Layer 3: Inner Dark Card (Glassmorphism effect) -->
    <item
        android:top="4dp"
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#1AFFFFFF"
                android:endColor="#0DFFFFFF" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

</layer-list>
