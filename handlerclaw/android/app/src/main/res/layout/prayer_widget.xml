<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_margin="8dp">

        <!-- Header row: icon + label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sholat"
                android:textColor="#FF4D4D"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Big count display -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#1A1814"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="4dp"
                android:text="/ 5"
                android:textColor="#9A928A"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Timestamp -->
        <TextView
            android:id="@+id/widget_last_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#9A928A"
            android:textSize="8sp"
            android:layout_marginTop="8dp" />

        <!-- Divider using FrameLayout instead of View -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDD7CE"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Prayer dots with labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Subuh -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/dot_subuh"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_dot_off" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textSize="8sp"
                    android:textColor="#9A928A"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Dzuhur -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/dot_dzuhur"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_dot_off" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D"
                    android:textSize="8sp"
                    android:textColor="#9A928A"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Ashar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/dot_ashar"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_dot_off" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textSize="8sp"
                    android:textColor="#9A928A"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Maghrib -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/dot_maghrib"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_dot_off" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="M"
                    android:textSize="8sp"
                    android:textColor="#9A928A"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Isya -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/dot_isya"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_dot_off" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I"
                    android:textSize="8sp"
                    android:textColor="#9A928A"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Mosque Icon Overlay -->
    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_mosque"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:alpha="0.8" />

</RelativeLayout>