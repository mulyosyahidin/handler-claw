// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrayerCategory {
  WAJIB
  SUNNAH
}

enum PrayerType {
  SUBUH
  DZUHUR
  ASHAR
  MAGHRIB
  ISYA
  JUMAT

  DHUHA
  TAHAJUD
  WITIR
}

enum PrayerMethod {
  JAMAAH
  SENDIRI
}

enum PrayerPlace {
  MASJID
  RUMAH
  LAINNYA
}

enum UserDevicePlatform {
  ANDROID
  IOS
  WEB
  WINDOWS
}

enum UserDeviceStatus {
  ACTIVE
  LOGGED_OUT
  INVALID_TOKEN
}

enum NotificationWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum UserDriver {
  EMAIL
  GOOGLE
}

model User {
  id          String    @id @default(uuid())
  driver      UserDriver @default(EMAIL)
  email       String    @unique
  name        String
  password    String?
  lastLoginAt DateTime? @map("last_login_at")
  avatarUrl   String?   @map("avatar_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  prayerLogs PrayerLog[]
  userDevices    UserDevice[]
  notificationWebhooks NotificationWebhook[]
  notifications Notification[]
  whatsappLogs  WhatsappLog[]

  @@map("users")
}

model PrayerLog {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  date     DateTime       @db.Date
  prayer   PrayerType
  category PrayerCategory

  performed   Boolean   @default(false)
  performedAt DateTime? @map("performed_at")

  method PrayerMethod?
  place  PrayerPlace?

  isQadha Boolean @default(false) @map("is_qadha")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, date])
  @@map("prayer_logs")
}

model WhatsappLog {
  id String @id @default(uuid())
  
  receivedAt DateTime @default(now()) @map("received_at")

  // Device & routing
  device String @db.VarChar(30)
  mode   String @db.VarChar(10)

  // Sender info
  sender     String  @db.VarChar(50)
  senderLid  String? @map("sender_lid") @db.VarChar(60)
  senderName String? @map("sender_name") @db.VarChar(100)

  // Group info
  isGroup     Boolean @default(false) @map("is_group")
  groupId     String? @map("group_id") @db.VarChar(60)
  memberPhone String? @map("member_phone") @db.VarChar(30)
  memberLid   String? @map("member_lid") @db.VarChar(60)

  // Message
  messageText String? @map("message_text") @db.Text
  messageType String  @map("message_type") @db.VarChar(20)
  isForwarded Boolean @default(false) @map("is_forwarded")
  isQuick     Boolean @default(false) @map("is_quick")
  inboxId     Int     @default(0) @map("inbox_id")

  // Media (null kalau plain text)
  extension String? @db.VarChar(20)
  filename  String? @db.VarChar(255)
  url       String? @db.VarChar(500)
  location  String? @db.VarChar(255)

  // Poll
  pollName    String? @map("poll_name") @db.VarChar(255)
  pollChoices Json?   @map("poll_choices")

  // Original timestamp dari WA
  waTimestamp BigInt @map("wa_timestamp")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sender])
  @@index([device])
  @@index([receivedAt])
  @@index([isGroup])
  @@map("whatsapp_logs")
}

model UserDevice {
  id     String           @id @default(uuid())
  userId String           @map("user_id")
  status UserDeviceStatus @default(ACTIVE)

  deviceId    String  @map("device_id")
  deviceBrand String? @map("device_brand")
  deviceModel String? @map("device_model")
  osBuildId   String? @map("os_build_id")
  osVersion   String? @map("os_version")

  fcmToken String             @map("fcm_token")
  platform UserDevicePlatform @default(ANDROID)

  lastSeenAt DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_devices")
}

model NotificationWebhook {
  id     String @id @default(uuid())
  userId String @map("user_id")

  status  NotificationWebhookStatus @default(RECEIVED)
  content Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId])
  @@index([createdAt])
  @@map("notification_webhooks")
}

model Notification {
  id                    String @id @default(uuid())
  notificationWebhookId String @map("notification_webhook_id")

  userId       String @map("user_id")
  userDeviceId String @map("user_device_id")

  title String
  body  String
  data  Json?

  triggeredAt DateTime? @map("triggered_at")

  status       NotificationStatus @default(PENDING)
  fcmMessageId String?            @map("fcm_message_id")

  sentAt   DateTime? @map("sent_at")
  failedAt DateTime? @map("failed_at")

  retryCount   Int     @default(0) @map("retry_count")
  errorMessage String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notificationWebhook NotificationWebhook @relation(fields: [notificationWebhookId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userDevice          UserDevice          @relation(fields: [userDeviceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([userDeviceId])
  @@map("notifications")
}

model File {
  id String @id @default(uuid())

  fileName String @map("file_name")
  fileType String @map("file_type")
  fileSize Int @map("file_size")
  filePath String @map("file_path")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("files")
}
