// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrayerCategory {
  WAJIB
  SUNNAH
}

enum PrayerType {
  // wajib
  SUBUH
  DZUHUR
  ASHAR
  MAGHRIB
  ISYA
  JUMAT

  // sunnah
  DHUHA
  TAHAJUD
  WITIR
}

enum PrayerMethod {
  JAMAAH
  SENDIRI
}

enum PrayerPlace {
  MASJID
  RUMAH
  LAINNYA
}

enum ReminderHookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum UserDevicePlatform {
  ANDROID
  IOS
  WEB
  WINDOWS
}

enum UserDeviceStatus {
  ACTIVE
  LOGGED_OUT
  INVALID_TOKEN
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String
  password    String
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  prayerLogs    PrayerLog[]
  reminderHooks ReminderHook[]
  userDevices   UserDevice[]
  notifications Notification[]

  @@map("users")
}

model PrayerLog {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  date     DateTime       @db.Date
  prayer   PrayerType
  category PrayerCategory

  performed   Boolean   @default(false)
  performedAt DateTime? @map("performed_at")

  method PrayerMethod?
  place  PrayerPlace?

  isQadha Boolean @default(false) @map("is_qadha")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, date])
  @@map("prayer_logs")
}

model WhatsappLog {
  id         Int      @id @default(autoincrement())
  receivedAt DateTime @default(now())

  // Device & routing
  device String @db.VarChar(30)
  mode   String @db.VarChar(10)

  // Sender info
  sender     String  @db.VarChar(50)
  senderLid  String? @db.VarChar(60)
  senderName String? @db.VarChar(100)

  // Group info
  isGroup     Boolean @default(false)
  groupId     String? @db.VarChar(60)
  memberPhone String? @db.VarChar(30)
  memberLid   String? @db.VarChar(60)

  // Message
  messageText String? @db.Text
  messageType String  @db.VarChar(20) // text, image, document, dll
  isForwarded Boolean @default(false)
  isQuick     Boolean @default(false)
  inboxId     Int     @default(0)

  // Media (null kalau plain text)
  extension String? @db.VarChar(20)
  filename  String? @db.VarChar(255)
  url       String? @db.VarChar(500)
  location  String? @db.VarChar(255)

  // Poll
  pollName    String? @db.VarChar(255)
  pollChoices Json?

  // Original timestamp dari WA
  waTimestamp BigInt

  @@index([sender])
  @@index([device])
  @@index([receivedAt])
  @@index([isGroup])
  @@map("whatsapp_logs")
}

model ReminderHook {
  id      String @id @default(uuid())
  userId  String @map("user_id")
  eventId String @map("event_id")

  status ReminderHookStatus @default(RECEIVED)

  headersJson Json @map("headers_json")
  payloadJson Json @map("payload_json")

  errorMessage String?   @map("error_message")
  processedAt  DateTime? @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([userId, eventId])
  @@index([userId])
  @@index([createdAt])
  @@map("reminder_hooks")
}

model UserDevice {
  id     String           @id @default(uuid())
  userId String           @map("user_id")
  status UserDeviceStatus @default(ACTIVE)

  deviceId    String  @unique @map("device_id")
  deviceBrand String? @map("device_brand")
  deviceModel String? @map("device_model")
  osVersion   String? @map("os_version")

  fcmToken String             @map("fcm_token")
  platform UserDevicePlatform @default(ANDROID)

  lastSeenAt DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId])
  @@map("user_devices")
}

model Notification {
  id           String @id @default(uuid())
  reminderHookId String @map("reminder_hook_id")

  userId       String @map("user_id")
  userDeviceId String @map("user_device_id")

  title String
  body  String
  data  Json?

  triggeredAt DateTime? @map("triggered_at")

  status       NotificationStatus @default(PENDING)
  fcmMessageId String?            @map("fcm_message_id")

  sentAt   DateTime? @map("sent_at")
  failedAt DateTime? @map("failed_at")

  retryCount   Int     @default(0)
  errorMessage String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reminderHook ReminderHook @relation(fields: [reminderHookId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userDevice UserDevice @relation(fields: [userDeviceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([userDeviceId])
  @@map("notifications")
}
