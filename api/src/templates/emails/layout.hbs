<html lang="id" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{{subject}}</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Poppins:wght@400;500;600;700&display=swap");

      /* Reset */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body,
      table,
      td,
      a {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }
      table,
      td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      img {
        -ms-interpolation-mode: bicubic;
        border: 0;
        display: block;
      }
      a {
        color: inherit;
        text-decoration: none;
      }

      /* Base */
      body {
        background-color: #faf8f5;
        font-family: "Poppins", "Segoe UI", sans-serif;
        font-size: 16px;
        line-height: 1.6;
        color: #1a1814;
        margin: 0;
        padding: 0;
      }

      .email-wrapper {
        background-color: #faf8f5;
        padding: 32px 16px;
      }

      /* Container */
      .email-container {
        max-width: 600px;
        margin: 0 auto;
        border-radius: 20px;
        overflow: hidden;
        box-shadow:
          0 8px 40px rgba(255, 77, 77, 0.12),
          0 2px 12px rgba(0, 0, 0, 0.06);
      }

      /* ─── HEADER ─── */
      .email-header {
        background: linear-gradient(135deg, #ff4d4d 0%, #ff7a7a 60%, #ffd9d9 100%);
        padding: 0;
        position: relative;
        overflow: hidden;
      }

      .header-bg-shapes {
        position: relative;
        padding: 40px 40px 36px;
      }

      /* Decorative circles */
      .header-bg-shapes::before {
        content: "";
        position: absolute;
        top: -30px;
        right: -30px;
        width: 180px;
        height: 180px;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 50%;
      }

      .header-bg-shapes::after {
        content: "";
        position: absolute;
        bottom: -50px;
        left: -20px;
        width: 140px;
        height: 140px;
        background: rgba(204, 0, 0, 0.15);
        border-radius: 50%;
      }

      .header-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .header-logo-mark {
        width: 48px;
        height: 48px;
        background: #ffffff;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
        flex-shrink: 0;
        font-size: 24px;
        line-height: 1;
        text-align: center;
        padding-top: 4px;
      }

      .header-brand {
        font-family: "Nunito", sans-serif;
        font-weight: 900;
        font-size: 26px;
        color: #ffffff;
        letter-spacing: -0.5px;
        text-shadow: 0 2px 8px rgba(204, 0, 0, 0.25);
      }

      .header-tagline {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.85);
        font-weight: 500;
        margin-top: 1px;
        letter-spacing: 0.3px;
      }

      /* Subject badge */
      .header-subject-row {
        position: relative;
        z-index: 1;
        margin-top: 24px;
      }

      .header-subject-badge {
        display: inline-block;
        background: rgba(255, 255, 255, 0.2);
        border: 1.5px solid rgba(255, 255, 255, 0.35);
        color: #ffffff;
        font-family: "Nunito", sans-serif;
        font-weight: 800;
        font-size: 18px;
        padding: 8px 18px 8px 14px;
        border-radius: 50px;
        backdrop-filter: blur(4px);
        letter-spacing: -0.2px;
      }

      .header-subject-badge .dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        background: #ffd9d9;
        border-radius: 50%;
        margin-right: 8px;
        vertical-align: middle;
        position: relative;
        top: -1px;
      }

      /* ─── BODY ─── */
      .email-body {
        background-color: #ffffff;
        padding: 40px 40px 36px;
      }

      /* Divider accent strip */
      .accent-strip {
        height: 4px;
        background: linear-gradient(90deg, #ff4d4d, #ffc107, #4caf50, #2196f3, #ff4d4d);
        background-size: 200% 100%;
      }

      /* ─── FOOTER ─── */
      .email-footer {
        background-color: #faf8f5;
        border-top: 1.5px solid #ddd7ce;
        padding: 28px 40px 32px;
        text-align: center;
      }

      .footer-links {
        margin-bottom: 14px;
      }

      .footer-links a {
        color: #ff4d4d;
        font-size: 13px;
        font-weight: 600;
        margin: 0 10px;
        text-decoration: none;
      }

      .footer-links a:hover {
        text-decoration: underline;
      }

      .footer-separator {
        color: #ddd7ce;
        margin: 0 4px;
      }

      .footer-social {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 18px;
      }

      .social-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #ffd9d9;
        color: #cc0000;
        font-size: 12px;
        font-weight: 700;
        padding: 5px 13px;
        border-radius: 50px;
        font-family: "Nunito", sans-serif;
        letter-spacing: 0.2px;
      }

      .footer-copy {
        color: #9a928a;
        font-size: 12px;
        line-height: 1.7;
      }

      .footer-copy strong {
        color: #ff4d4d;
      }

      .footer-unsubscribe {
        margin-top: 10px;
        font-size: 11px;
        color: #9a928a;
      }

      .footer-unsubscribe a {
        color: #9a928a;
        text-decoration: underline;
      }

      /* ─── Responsive ─── */
      @media (max-width: 480px) {
        .email-wrapper {
          padding: 16px 8px;
        }
        .email-body {
          padding: 28px 24px;
        }
        .header-bg-shapes {
          padding: 28px 24px 24px;
        }
        .email-footer {
          padding: 22px 24px 26px;
        }
        .header-brand {
          font-size: 22px;
        }
        .footer-social {
          flex-wrap: wrap;
        }
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <table
        class="email-container"
        width="100%"
        cellpadding="0"
        cellspacing="0"
        role="presentation"
      >

        <!-- ═══ HEADER ═══ -->
        <tr>
          <td class="email-header">
            <div class="header-bg-shapes">
              <div class="header-inner">
                <div class="header-logo-mark">🎯</div>
                <div>
                  <div class="header-brand">HandlerClaw</div>
                  <div class="header-tagline">Don't miss anything ✦</div>
                </div>
              </div>
              <div class="header-subject-row">
                <span class="header-subject-badge">
                  <span class="dot"></span>{{subject}}
                </span>
              </div>
            </div>
          </td>
        </tr>

        <!-- Accent strip -->
        <tr>
          <td class="accent-strip"></td>
        </tr>

        <!-- ═══ BODY (injected by template) ═══ -->
        <tr>
          <td class="email-body">
            {{{body}}}
          </td>
        </tr>

        <!-- ═══ FOOTER ═══ -->
        <tr>
          <td class="email-footer">
            <div class="footer-social">
              <span class="social-pill">🐦 Twitter</span>
              <span class="social-pill">📸 Instagram</span>
              <span class="social-pill">💼 LinkedIn</span>
            </div>

            <div class="footer-links">
              <a href="{{appUrl}}/help">Bantuan</a>
              <span class="footer-separator">·</span>
              <a href="{{appUrl}}/privacy">Privasi</a>
              <span class="footer-separator">·</span>
              <a href="{{appUrl}}/terms">Syarat & Ketentuan</a>
            </div>

            <div class="footer-copy">
              Email ini dikirim oleh
              <strong>HandlerClaw</strong><br />
              ©
              {{year}}
              HandlerClaw. Hak cipta dilindungi.
            </div>

            <div class="footer-unsubscribe">
              Tidak ingin menerima email ini?
              <a href="{{appUrl}}/unsubscribe">Berhenti berlangganan</a>
            </div>
          </td>
        </tr>

      </table>
    </div>
  </body>
</html>